<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZomboidRCON.Views.SetPasswordWindow"
        Title="Set Password"
        Width="350" Height="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="/Assets/Icons/icon.ico">

    <StackPanel Margin="16" Spacing="8">
        <TextBlock x:Name="PlayerNameText" FontWeight="Bold"/>
        <TextBlock Text="New Password:" FontWeight="Bold"/>
        <TextBox x:Name="PasswordBox" PasswordChar="*"/>

        <Button x:Name="BtnSetPassword" Content="Set Password" Height="30" Click="OnSetPasswordClick"/>
    </StackPanel>
</Window>
